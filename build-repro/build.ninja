# =============================================================================
# Link build statements for STATIC_LIBRARY target glfw


#############################################
# Link the static library third_party/glfw/src/libglfw3.a

build third_party/glfw/src/libglfw3.a: C_STATIC_LIBRARY_LINKER__glfw_Release third_party/glfw/src/CMakeFiles/glfw.dir/context.c.o third_party/glfw/src/CMakeFiles/glfw.dir/init.c.o third_party/glfw/src/CMakeFiles/glfw.dir/input.c.o third_party/glfw/src/CMakeFiles/glfw.dir/monitor.c.o third_party/glfw/src/CMakeFiles/glfw.dir/platform.c.o third_party/glfw/src/CMakeFiles/glfw.dir/vulkan.c.o third_party/glfw/src/CMakeFiles/glfw.dir/window.c.o third_party/glfw/src/CMakeFiles/glfw.dir/egl_context.c.o third_party/glfw/src/CMakeFiles/glfw.dir/osmesa_context.c.o third_party/glfw/src/CMakeFiles/glfw.dir/null_init.c.o third_party/glfw/src/CMakeFiles/glfw.dir/null_monitor.c.o third_party/glfw/src/CMakeFiles/glfw.dir/null_window.c.o third_party/glfw/src/CMakeFiles/glfw.dir/null_joystick.c.o third_party/glfw/src/CMakeFiles/glfw.dir/posix_module.c.o third_party/glfw/src/CMakeFiles/glfw.dir/posix_time.c.o third_party/glfw/src/CMakeFiles/glfw.dir/posix_thread.c.o third_party/glfw/src/CMakeFiles/glfw.dir/x11_init.c.o third_party/glfw/src/CMakeFiles/glfw.dir/x11_monitor.c.o third_party/glfw/src/CMakeFiles/glfw.dir/x11_window.c.o third_party/glfw/src/CMakeFiles/glfw.dir/xkb_unicode.c.o third_party/glfw/src/CMakeFiles/glfw.dir/glx_context.c.o third_party/glfw/src/CMakeFiles/glfw.dir/linux_joystick.c.o third_party/glfw/src/CMakeFiles/glfw.dir/posix_poll.c.o
  LANGUAGE_COMPILE_FLAGS = -O3 -DNDEBUG
  OBJECT_DIR = third_party/glfw/src/CMakeFiles/glfw.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = third_party/glfw/src/libglfw3.a
  TARGET_PDB = glfw3.a.dbg


#############################################
# Utility command for update_mappings

build third_party/glfw/src/update_mappings: phony third_party/glfw/src/CMakeFiles/update_mappings


#############################################
# Utility command for test

build third_party/glfw/src/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build-repro/third_party/glfw/src && /usr/bin/ctest --force-new-ctest-process
  DESC = Running tests...
  pool = console
  restat = 1

build third_party/glfw/src/test: phony third_party/glfw/src/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build third_party/glfw/src/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build-repro/third_party/glfw/src && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build third_party/glfw/src/edit_cache: phony third_party/glfw/src/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build third_party/glfw/src/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build-repro/third_party/glfw/src && /usr/bin/cmake --regenerate-during-build -S/workspace -B/workspace/build-repro
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build third_party/glfw/src/rebuild_cache: phony third_party/glfw/src/CMakeFiles/rebuild_cache.util


#############################################
# Custom command for third_party/glfw/src/CMakeFiles/update_mappings

build third_party/glfw/src/CMakeFiles/update_mappings | ${cmake_ninja_workdir}third_party/glfw/src/CMakeFiles/update_mappings: CUSTOM_COMMAND
  COMMAND = cd /workspace/third_party/glfw/src && /usr/bin/cmake -P /workspace/third_party/glfw/CMake/GenerateMappings.cmake mappings.h.in mappings.h
  DESC = Updating gamepad mappings from upstream repository

# =============================================================================
# Target aliases.

build bullet: phony libbullet.a

build glfw: phony third_party/glfw/src/libglfw3.a

build imgui: phony libimgui.a

build libglfw3.a: phony third_party/glfw/src/libglfw3.a

build pmx_core: phony libpmx_core.a

build pmx_gpu: phony libpmx_gpu.a

build update_mappings: phony third_party/glfw/src/update_mappings

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: /workspace/build-repro

build all: phony libimgui.a libbullet.a libpmx_core.a libpmx_gpu.a pmxstudio third_party/glfw/all

# =============================================================================

#############################################
# Folder: /workspace/build-repro/third_party/glfw

build third_party/glfw/all: phony third_party/glfw/src/all

# =============================================================================

#############################################
# Folder: /workspace/build-repro/third_party/glfw/src

build third_party/glfw/src/all: phony third_party/glfw/src/libglfw3.a

# =============================================================================
# Built-in targets


